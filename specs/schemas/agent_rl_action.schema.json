{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shenli.github.io/nanopt/schemas/agent_rl_action.schema.json",
  "title": "NanoPT exact-token Agent RL action",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "turn_index", "prompt_token_ids", "sampled_token_ids", "action_mask",
    "old_logprobs", "reference_logprobs", "decoded_text", "action_parse_status", "tool",
    "advantage"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "turn_index": {"type": "integer", "minimum": 0},
    "prompt_token_ids": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 0}},
    "sampled_token_ids": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 0}},
    "action_mask": {"type": "array", "minItems": 1, "items": {"type": "boolean"}},
    "old_logprobs": {"type": "array", "minItems": 1, "items": {"type": "number"}},
    "reference_logprobs": {"type": ["array", "null"], "items": {"type": "number"}},
    "decoded_text": {"type": "string"},
    "action_parse_status": {"enum": ["valid", "invalid", "error"]},
    "tool": {"type": ["string", "null"]},
    "advantage": {"type": "number"}
  }
}
