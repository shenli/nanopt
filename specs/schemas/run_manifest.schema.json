{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://nanopt.dev/schemas/run_manifest.schema.json",
  "title": "NanoPT Run Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "stage",
    "status",
    "created_at",
    "git",
    "config",
    "environment_file",
    "model",
    "data"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "minLength": 1},
    "pipeline_run_id": {"type": ["string", "null"]},
    "parent_run_ids": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "stage": {
      "enum": ["evaluation", "sft", "dpo", "grpo", "agent_evaluation", "agent_sft", "agent_rl", "teaching_lab", "pipeline"]
    },
    "status": {
      "enum": ["created", "running", "completed", "failed", "interrupted", "tainted"]
    },
    "created_at": {"type": "string", "format": "date-time"},
    "started_at": {"type": ["string", "null"], "format": "date-time"},
    "finished_at": {"type": ["string", "null"], "format": "date-time"},
    "git": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "dirty"],
      "properties": {
        "commit": {"type": "string"},
        "dirty": {"type": "boolean"},
        "tag": {"type": ["string", "null"]},
        "remote": {"type": ["string", "null"]}
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": ["resolved_file", "sha256"],
      "properties": {
        "resolved_file": {"type": "string"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "provenance_file": {"type": ["string", "null"]}
      }
    },
    "environment_file": {"type": "string"},
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["model_id", "resolved_revision", "tokenizer_revision"],
      "properties": {
        "model_id": {"type": "string"},
        "resolved_revision": {"type": "string"},
        "tokenizer_revision": {"type": "string"},
        "chat_template_sha256": {"type": ["string", "null"]},
        "base_parameter_count": {"type": ["integer", "null"], "minimum": 0},
        "trainable_parameter_count": {"type": ["integer", "null"], "minimum": 0},
        "adapter_name": {"type": ["string", "null"]},
        "adapter_sha256": {"type": ["string", "null"]},
        "parent_adapter_sha256": {"type": ["string", "null"]}
      }
    },
    "data": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dataset_ids", "fingerprints"],
      "properties": {
        "dataset_ids": {"type": "array", "items": {"type": "string"}},
        "fingerprints": {
          "type": "object",
          "additionalProperties": {"type": "string"}
        },
        "protected_splits_used_for_training": {"type": "boolean", "const": false}
      }
    },
    "checkpoint": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "path": {"type": "string"},
        "sha256": {"type": "string"},
        "parent_checkpoint_sha256": {"type": ["string", "null"]}
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "kind"],
        "properties": {
          "path": {"type": "string"},
          "kind": {"type": "string"},
          "sha256": {"type": ["string", "null"]}
        }
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "device", "task_count", "representative"],
      "properties": {
        "mode": {"enum": ["deterministic", "sampled"]},
        "device": {"enum": ["cpu", "cuda"]},
        "task_count": {"type": "integer", "minimum": 1},
        "representative": {"type": "boolean"},
        "peak_reserved_bytes": {"type": "integer", "minimum": 0}
      }
    },
    "training": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "device", "train_examples", "validation_examples", "representative", "resumed"
          ],
          "properties": {
            "device": {"enum": ["cpu", "cuda"]},
            "train_examples": {"type": "integer", "minimum": 1},
            "validation_examples": {"type": "integer", "minimum": 1},
            "representative": {"type": "boolean"},
            "resumed": {"type": "boolean"}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "device", "train_pairs", "validation_pairs", "optimizer_steps", "representative",
            "initial_policy_is_exact_sft_copy"
          ],
          "properties": {
            "device": {"enum": ["cpu", "cuda"]},
            "train_pairs": {"type": "integer", "minimum": 1},
            "validation_pairs": {"type": "integer", "minimum": 1},
            "optimizer_steps": {"type": "integer", "minimum": 1},
            "representative": {"type": "boolean"},
            "initial_policy_is_exact_sft_copy": {"const": true}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "device", "iterations", "optimizer_steps", "trajectories", "completions",
            "representative", "consumed_exact_stored_token_ids"
          ],
          "properties": {
            "device": {"enum": ["cpu", "cuda"]},
            "iterations": {"type": "integer", "minimum": 1},
            "optimizer_steps": {"type": "integer", "minimum": 1},
            "trajectories": {"type": "integer", "minimum": 1},
            "completions": {"type": "integer", "minimum": 2},
            "representative": {"type": "boolean"},
            "consumed_exact_stored_token_ids": {"const": true}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "device", "exact_stored_token_ids", "context_policy", "train_examples",
            "validation_examples"
          ],
          "properties": {
            "device": {"enum": ["cpu", "cuda"]},
            "exact_stored_token_ids": {"const": true},
            "context_policy": {"enum": ["observation_snapshot", "full_transcript"]},
            "train_examples": {"type": "integer", "minimum": 1},
            "validation_examples": {"type": "integer", "minimum": 1}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "device", "iterations", "optimizer_steps", "groups", "episodes", "actions",
            "representative", "consumed_exact_stored_token_ids", "maximum_policy_lag",
            "hidden_reward_exposed_during_rollout"
          ],
          "properties": {
            "device": {"enum": ["cpu", "cuda"]},
            "iterations": {"type": "integer", "minimum": 1},
            "optimizer_steps": {"type": "integer", "minimum": 1},
            "groups": {"type": "integer", "minimum": 1},
            "episodes": {"type": "integer", "minimum": 2},
            "actions": {"type": "integer", "minimum": 1},
            "representative": {"type": "boolean"},
            "consumed_exact_stored_token_ids": {"const": true},
            "maximum_policy_lag": {"const": 0},
            "hidden_reward_exposed_during_rollout": {"const": false}
          }
        }
      ]
    },
    "agent_environment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "backend", "image", "docker_evidence", "network", "run_as_non_root", "expose_gpu",
        "capabilities_dropped", "no_new_privileges", "root_filesystem_read_only",
        "separate_hidden_workspace", "hidden_source_exposed", "policy", "representative",
        "environment_trains_model", "task_count", "solved", "replay_checked"
      ],
      "properties": {
        "backend": {"enum": ["fake", "docker"]},
        "image": {"type": ["string", "null"]},
        "docker_evidence": {"type": ["object", "null"]},
        "network": {"enum": ["none", "host-test-only"]},
        "run_as_non_root": {"type": "boolean"},
        "expose_gpu": {"const": false},
        "capabilities_dropped": {"type": "boolean"},
        "no_new_privileges": {"type": "boolean"},
        "root_filesystem_read_only": {"type": "boolean"},
        "separate_hidden_workspace": {"const": true},
        "hidden_source_exposed": {"const": false},
        "policy": {"enum": ["oracle", "model"]},
        "representative": {"type": "boolean"},
        "environment_trains_model": {"type": "boolean"},
        "task_count": {"type": "integer", "minimum": 1},
        "solved": {"type": "integer", "minimum": 0},
        "replay_checked": {"type": "boolean"}
      }
    },
    "failure": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "properties": {
        "type": {"type": "string"},
        "message": {"type": "string"},
        "phase": {"type": ["string", "null"]},
        "traceback_file": {"type": ["string", "null"]}
      }
    }
  }
}
