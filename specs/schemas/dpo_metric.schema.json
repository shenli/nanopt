{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shenli.github.io/nanopt/schemas/dpo_metric.schema.json",
  "title": "NanoPT DPO metric record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "run_id", "split", "optimizer_step", "dpo_loss",
    "policy_chosen_logp", "policy_rejected_logp", "policy_margin", "reference_margin",
    "implicit_reward_margin", "preference_accuracy", "reward_accuracy", "pair_count",
    "chosen_active_tokens", "rejected_active_tokens", "peak_allocated_bytes",
    "peak_reserved_bytes"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "minLength": 1},
    "split": {"enum": ["train", "validation"]},
    "optimizer_step": {"type": "integer", "minimum": 0},
    "dpo_loss": {"type": "number", "minimum": 0},
    "policy_chosen_logp": {"type": "number"},
    "policy_rejected_logp": {"type": "number"},
    "policy_margin": {"type": "number"},
    "reference_margin": {"type": "number"},
    "implicit_reward_margin": {"type": "number"},
    "preference_accuracy": {"type": "number", "minimum": 0, "maximum": 1},
    "reward_accuracy": {"type": "number", "minimum": 0, "maximum": 1},
    "pair_count": {"type": "integer", "minimum": 1},
    "chosen_active_tokens": {"type": "number", "exclusiveMinimum": 0},
    "rejected_active_tokens": {"type": "number", "exclusiveMinimum": 0},
    "learning_rate": {"type": ["number", "null"], "minimum": 0},
    "gradient_norm": {"type": ["number", "null"], "minimum": 0},
    "gradient_clipped": {"type": ["boolean", "null"]},
    "peak_allocated_bytes": {"type": "integer", "minimum": 0},
    "peak_reserved_bytes": {"type": "integer", "minimum": 0}
  }
}
