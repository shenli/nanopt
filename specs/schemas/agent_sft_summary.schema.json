{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shenli.github.io/nanopt/schemas/agent_sft_summary.schema.json",
  "title": "NanoPT Agent SFT run summary",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "run_id", "optimizer_steps", "train_examples", "validation_examples",
    "initial_validation_nll", "final_validation_nll", "initial_validation_token_accuracy",
    "final_validation_token_accuracy", "peak_allocated_bytes", "peak_reserved_bytes",
    "context_policy", "held_out_task_ids"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "minLength": 1},
    "optimizer_steps": {"type": "integer", "minimum": 1},
    "train_examples": {"type": "integer", "minimum": 1},
    "validation_examples": {"type": "integer", "minimum": 1},
    "initial_validation_nll": {"type": "number", "minimum": 0},
    "final_validation_nll": {"type": "number", "minimum": 0},
    "initial_validation_token_accuracy": {"type": "number", "minimum": 0, "maximum": 1},
    "final_validation_token_accuracy": {"type": "number", "minimum": 0, "maximum": 1},
    "peak_allocated_bytes": {"type": "integer", "minimum": 0},
    "peak_reserved_bytes": {"type": "integer", "minimum": 0},
    "context_policy": {"enum": ["observation_snapshot", "full_transcript"]},
    "held_out_task_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}}
  }
}
