{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shenli.github.io/nanopt/schemas/agent_sft_dataset.schema.json",
  "title": "NanoPT Agent SFT dataset manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "dataset_id", "dataset_sha256", "suite_id", "suite_version",
    "context_policy", "tokenizer_revision", "chat_template_sha256", "examples_file",
    "examples_sha256", "source_trajectories_sha256", "train_tasks", "validation_tasks",
    "train_examples", "validation_examples", "demonstration_examples", "recovery_examples",
    "exact_replays_passed", "source_trajectories", "hidden_test_source_included"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "dataset_id": {"type": "string", "minLength": 1},
    "dataset_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "suite_id": {"type": "string", "minLength": 1},
    "suite_version": {"type": "string", "minLength": 1},
    "context_policy": {"enum": ["observation_snapshot", "full_transcript"]},
    "tokenizer_revision": {"type": "string", "minLength": 1},
    "chat_template_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "examples_file": {"type": "string", "minLength": 1},
    "examples_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_trajectories_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "train_tasks": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "validation_tasks": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "train_examples": {"type": "integer", "minimum": 1},
    "validation_examples": {"type": "integer", "minimum": 1},
    "demonstration_examples": {"type": "integer", "minimum": 1},
    "recovery_examples": {"type": "integer", "minimum": 0},
    "exact_replays_passed": {"type": "integer", "minimum": 1},
    "source_trajectories": {"type": "integer", "minimum": 1},
    "hidden_test_source_included": {"const": false}
  }
}
