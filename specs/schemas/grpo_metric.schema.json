{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shenli.github.io/nanopt/schemas/grpo_metric.schema.json",
  "title": "NanoPT GRPO iteration metric",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "run_id", "iteration", "prompt_count", "completion_count",
    "active_tokens", "reward_mean", "reward_std", "reward_min", "reward_max",
    "correctness_rate", "parser_success_rate", "group_reward_std_mean",
    "degenerate_group_fraction", "advantage_mean", "advantage_std", "advantage_max_abs",
    "completion_length_mean", "protocol_stop_fraction", "eos_fraction",
    "max_length_fraction", "policy_loss", "kl_loss", "total_loss", "clip_fraction",
    "ratio_mean", "ratio_p95", "current_minus_old_logp_mean", "sampled_action_surprisal",
    "learning_rate", "gradient_norm", "gradient_clipped", "rollout_seconds",
    "training_seconds", "peak_allocated_bytes", "peak_reserved_bytes"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "run_id": {"type": "string", "minLength": 1},
    "iteration": {"type": "integer", "minimum": 0},
    "prompt_count": {"type": "integer", "minimum": 1},
    "completion_count": {"type": "integer", "minimum": 2},
    "active_tokens": {"type": "integer", "minimum": 1},
    "reward_mean": {"type": "number"},
    "reward_std": {"type": "number", "minimum": 0},
    "reward_min": {"type": "number"},
    "reward_max": {"type": "number"},
    "correctness_rate": {"type": "number", "minimum": 0, "maximum": 1},
    "parser_success_rate": {"type": "number", "minimum": 0, "maximum": 1},
    "group_reward_std_mean": {"type": "number", "minimum": 0},
    "degenerate_group_fraction": {"type": "number", "minimum": 0, "maximum": 1},
    "advantage_mean": {"type": "number"},
    "advantage_std": {"type": "number", "minimum": 0},
    "advantage_max_abs": {"type": "number", "minimum": 0},
    "completion_length_mean": {"type": "number", "exclusiveMinimum": 0},
    "protocol_stop_fraction": {"type": "number", "minimum": 0, "maximum": 1},
    "eos_fraction": {"type": "number", "minimum": 0, "maximum": 1},
    "max_length_fraction": {"type": "number", "minimum": 0, "maximum": 1},
    "policy_loss": {"type": "number"},
    "kl_loss": {"type": "number"},
    "total_loss": {"type": "number"},
    "clip_fraction": {"type": "number", "minimum": 0, "maximum": 1},
    "ratio_mean": {"type": "number", "exclusiveMinimum": 0},
    "ratio_p95": {"type": "number", "exclusiveMinimum": 0},
    "current_minus_old_logp_mean": {"type": "number"},
    "sampled_action_surprisal": {"type": "number", "minimum": 0},
    "learning_rate": {"type": "number", "minimum": 0},
    "gradient_norm": {"type": "number", "minimum": 0},
    "gradient_clipped": {"type": "boolean"},
    "rollout_seconds": {"type": "number", "minimum": 0},
    "training_seconds": {"type": "number", "minimum": 0},
    "peak_allocated_bytes": {"type": "integer", "minimum": 0},
    "peak_reserved_bytes": {"type": "integer", "minimum": 0}
  }
}
